# This repo publishes the notes only. Ignore everything, then allow the notes
# and the README back in, so no venv, h5ad dump, cache or clone can be added
# by accident.
*

!.gitignore
!README.md
!NOTES/
!NOTES/*.md
!RESULTS/
!RESULTS/*.md

# The INBOX door: its instructions travel with the repo, but anything a person
# actually drops in there does not.
!INBOX/
INBOX/*
!INBOX/README.md
!INBOX/HOW-TO.md

# Source only from Scanpy_Agent: the extracted tools and the MCP server, never the
# venv, notebooks/, tests/, reports/ or tmp/.
!Scanpy_Agent/
Scanpy_Agent/*
!Scanpy_Agent/src/
Scanpy_Agent/src/*
!Scanpy_Agent/src/*.py
!Scanpy_Agent/src/tools/
Scanpy_Agent/src/tools/*
!Scanpy_Agent/src/tools/*.py
# ...plus the guard tests. The rest of tests/ (reference data, subsamples, logs,
# results) stays out: it is gigabytes of .h5ad.
!Scanpy_Agent/tests/
Scanpy_Agent/tests/*
!Scanpy_Agent/tests/code/
Scanpy_Agent/tests/code/*
!Scanpy_Agent/tests/code/clustering/
Scanpy_Agent/tests/code/clustering/*
!Scanpy_Agent/tests/code/clustering/test_tool_guards.py
!Scanpy_Agent/tests/code/inbox/
Scanpy_Agent/tests/code/inbox/*
!Scanpy_Agent/tests/code/inbox/*.py

# Source only from TISSUE_Agent: the wrappers and their runners, never the venv,
# the cloned repo, tmp/ or out/.
!TISSUE_Agent/
TISSUE_Agent/*
!TISSUE_Agent/run_tutorial.py
!TISSUE_Agent/src/
TISSUE_Agent/src/*
!TISSUE_Agent/src/*.py
