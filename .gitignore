# This repo publishes the notes only. Ignore everything, then allow the notes
# and the README back in, so no venv, h5ad dump, cache or clone can be added
# by accident.
*

!.gitignore
!README.md
!NOTES/
!NOTES/*.md

# Source only from TISSUE_Agent: the wrappers and their runners, never the venv,
# the cloned repo, tmp/ or out/.
!TISSUE_Agent/
TISSUE_Agent/*
!TISSUE_Agent/run_tutorial.py
!TISSUE_Agent/src/
TISSUE_Agent/src/*
!TISSUE_Agent/src/*.py
